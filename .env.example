# Ejemplo de variables de entorno para Novedades LZ Backend
# Copia este archivo como .env y reemplaza los valores con tus credenciales reales

# OCR.space API
# Obten tu API key gratuita en: https://ocr.space/ocrapi
OCR_SPACE_API_KEY=tu_api_key_de_ocr_space_aqui

# Cloudinary
# Obten tus credenciales en: https://console.cloudinary.com/
CLOUDINARY_CLOUD_NAME=tu_cloud_name_aqui
CLOUDINARY_API_KEY=tu_api_key_aqui
CLOUDINARY_API_SECRET=tu_api_secret_aqui
CLOUDINARY_URL=cloudinary://<your_api_key>:<your_api_secret>@<your_cloud_name>

# JWT Secret (cambiar en produccion)
# Generar uno aleatorio con: openssl rand -base64 64
JWT_SECRET=TuClaveSecretaSuperSeguraDeAlMenos64CaracteresParaHS512Algorithm

# Yape y panel admin
YAPE_RECIPIENT_NAME=Leslie Lopez
YAPE_RECIPIENT_PHONE=939662630
APP_ADMIN_ORDERS_URL=http://localhost:3000/admin/orders
APP_PUBLIC_BASE_URL=http://localhost:8080
WHATSAPP_APPROVAL_LINK_EXPIRATION_MINUTES=20

# Admin bootstrap de la aplicacion
# Crea el primer admin al arrancar si no existe.
# Solo resetea la password si APP_BOOTSTRAP_ADMIN_RESET_PASSWORD=true
APP_BOOTSTRAP_ADMIN_ENABLED=false
APP_BOOTSTRAP_ADMIN_EMAIL=admin@novedadeslz.com
APP_BOOTSTRAP_ADMIN_PASSWORD=Admin12345!
APP_BOOTSTRAP_ADMIN_FULL_NAME=Administrador
APP_BOOTSTRAP_ADMIN_PHONE=+51987654321
APP_BOOTSTRAP_ADMIN_RESET_PASSWORD=false

# Notificaciones WhatsApp al admin
WHATSAPP_NOTIFICATIONS_ENABLED=true
WHATSAPP_ADMIN_PHONE=+51939662630
# Proveedor: auto | callmebot | meta
WHATSAPP_PROVIDER=auto

# CallMeBot (recomendado: gratis, sin cuenta, solo para auto-notificarse)
# Como obtener la API key (una sola vez, desde el WhatsApp del admin):
# 1. Agrega el numero de CallMeBot a tus contactos (ver numero vigente en
#    https://www.callmebot.com/blog/free-api-whatsapp-messages/)
# 2. Envia por WhatsApp el mensaje: "I allow callmebot to send me messages"
# 3. El bot responde con tu API key personal; pegala aqui
WHATSAPP_CALLMEBOT_API_KEY=tu_api_key_de_callmebot

# WhatsApp Cloud API (Meta) - alternativa oficial, requiere app en Meta
WHATSAPP_CLOUD_API_ACCESS_TOKEN=
WHATSAPP_CLOUD_API_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_API_VERSION=v22.0

# Oracle Database (opcional, ya esta en application.properties)
# DB_URL=jdbc:oracle:thin:@//localhost:1521/XE
# DB_USERNAME=novedadeslz
# DB_PASSWORD=novedadeslz123

# Oracle Autonomous Database (OCI TLS sin wallet)
# Usa el connection string del servicio *_tp y agrega el prefijo jdbc:oracle:thin:@
# DB_URL=jdbc:oracle:thin:@(description=(retry_count=20)(retry_delay=3)(address=(protocol=tcps)(port=1522)(host=adb.sa-bogota-1.oraclecloud.com))(connect_data=(service_name=tu_servicio_tp.adb.oraclecloud.com))(security=(ssl_server_dn_match=yes)))
# DB_USERNAME=ADMIN
# DB_PASSWORD=tu_password_admin
